<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/battery_left"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_preview_ring_l" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="95%"
            android:textColor="@color/widget_on_surface"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="5dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/battery_case"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_preview_ring_case" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="65%"
                android:textColor="@color/widget_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_preview_case_short"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="8.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/battery_right"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_preview_ring_r" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="95%"
            android:textColor="@color/widget_on_surface"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:background="@drawable/widget_pill_selected"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_anc_short"
            android:src="@drawable/ic_widget_anc"
            android:tint="@color/widget_on_primary_container" />
    </LinearLayout>
</LinearLayout>
