<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <!-- TWS Strip: 3 Circular Battery Ring Pills (Left / Case / Right) -->
    <LinearLayout
        android:id="@+id/widget_compact_tws_group"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/widget_compact_left_ring"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/battery_left"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_compact_left_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_on_surface"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/widget_compact_case_ring"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/battery_case"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_compact_case_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_compact_case_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="8.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/widget_compact_right_ring"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@string/battery_right"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_compact_right_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_on_surface"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Single-Battery Headset Strip -->
    <LinearLayout
        android:id="@+id/widget_compact_single_group"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_compact_single_ring"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/battery_headset"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_compact_single_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_single_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick ANC Cycle Icon Button -->
    <LinearLayout
        android:id="@+id/widget_compact_anc_btn"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:background="@drawable/widget_pill_selected"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_compact_anc_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_anc_short"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
