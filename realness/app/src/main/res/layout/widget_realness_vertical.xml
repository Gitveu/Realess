<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_vertical_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="5dp">

    <!-- Circular Battery Ring Column -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="3dp"
        android:paddingVertical="4dp">

        <!-- TWS Vertical Ring Stack (L / R / C) -->
        <LinearLayout
            android:id="@+id/widget_vertical_tws_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_vertical_left_ring"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/battery_left"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_vertical_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_vertical_right_ring"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/battery_right"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_vertical_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_vertical_case_ring"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/battery_case"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_vertical_case"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_vertical_case_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="8sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Single-Battery Headset Stack -->
        <LinearLayout
            android:id="@+id/widget_vertical_single_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_vertical_single_ring"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/battery_headset"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_vertical_single_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom ANC Mode Icon Tile -->
    <LinearLayout
        android:id="@+id/widget_vertical_anc_btn"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_pill_selected"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_vertical_anc_icon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@string/widget_anc_short"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
