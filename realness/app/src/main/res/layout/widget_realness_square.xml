<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="7dp">

    <!-- Top Row: Left & Right Circular Battery Ring Panels -->
    <LinearLayout
        android:id="@+id/widget_square_tws_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <ImageView
                android:id="@+id/widget_square_left_ring"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/battery_left"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_square_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_on_surface"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <ImageView
                android:id="@+id/widget_square_right_ring"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/battery_right"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_square_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/widget_on_surface"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Single-Battery Headset Card (Logitech G733 / G435 etc.) -->
    <LinearLayout
        android:id="@+id/widget_square_single_group"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_square_single_ring"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/battery_headset"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_square_single_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—"
            android:textColor="@color/widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_square_single_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Row: Case Pill + Icon ANC Cycle Tile -->
    <LinearLayout
        android:id="@+id/widget_square_bottom_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_square_case_pill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inner"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/widget_square_case_ring"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/battery_case"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_square_case"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_square_case_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/widget_on_surface_variant"
                    android:textSize="8.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_square_anc_btn"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_selected"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_square_anc_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/widget_anc_short"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
